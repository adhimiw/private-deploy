# ============================================
# VARMAN CONSTRUCTIONS - Apache Configuration
# ============================================
# Place this file in your public_html root directory

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# Preserve Authorization header for PHP
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Force HTTPS (SSL) outside local Docker/dev access
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www (optional - choose one)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Add www (alternative - choose one)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

# Route API requests to PHP router (more robust)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/?$ /api/index.php [L,QSA]
RewriteRule ^api/(.*)$ /api/index.php [L,QSA]

# Ensure browsers requesting the default favicon path receive the current logo
RewriteRule ^favicon\.ico$ /assets/logo.png [L]

# Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent XSS attacks
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Remove server info
    Header always unset X-Powered-By
    
    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://resource.trickle.so; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://resource.trickle.so https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://resource.trickle.so; img-src 'self' data: https:; connect-src 'self' https://wa.me https://varmanconstructions.in https://resource.trickle.so;"

    # Ensure HTML updates are never stale
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Cache built assets aggressively; cache bust via query string
    <FilesMatch "\.(js|mjs|css|map)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Prevent access to sensitive files
<FilesMatch "(^\.env|\.json$|\.config\.js$|\.sqlite$)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to private folders
RewriteRule ^storage/ - [F,L]
RewriteRule ^legacy/ - [F,L]

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/json
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE text/xml application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# SPA Fallback - Route all non-file requests to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !\.(?:js|mjs|css|map|json|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot)$ [NC]
RewriteRule ^(.*)$ /index.html [L]

# Protect admin dashboard with HTTP Basic Auth outside local/dev access
<Files "portal.html">
    <If "%{HTTP_HOST} !~ m#^(localhost|127\.0\.0\.1)(:\d+)?$#">
        AuthType Basic
        AuthName "Restricted Admin"
        AuthUserFile "/home/u244089748/domains/varmanconstructions.in/public_html/storage/.htpasswd_admin"
        Require valid-user
    </If>
</Files>

# Disable directory browsing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8
